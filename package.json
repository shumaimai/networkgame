{
  "name": "networkgame",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app": "vite build && electron .",
    "e2e": "node e2e/run.mjs",
    "trial": "python tools/build_trial.py",
    "package": "vite build && electron-packager . NetworkShop --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(src|tests|e2e|tools|assets|shots|public|release|trial|dist-trial|saves|\\.devin|node_modules/(?!\\.bin))\""
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/zen-maru-gothic": "5.3.1"
  },
  "main": "electron/main.cjs",
  "productName": "NetworkShop",
  "description": "ネットワーク構築を学ぶ2Dゲーム"
}
